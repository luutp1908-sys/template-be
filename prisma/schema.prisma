generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.VarChar(320)
  passwordHash     String    @db.VarChar(255)
  refreshTokenHash String?   @db.VarChar(255)
  displayName      String?   @db.VarChar(120)
  avatarUrl        String?   @db.VarChar(2048)
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ownedTeams        Team[]      @relation("TeamOwner")
  authoredTemplates Template[]  @relation("TemplateAuthor")
  drafts            UserDraft[]
  assets            Asset[]
  exports           Export[]
  userRoles         UserRole[]
  workspaceMembers  WorkspaceMember[]
  invitedMembers    WorkspaceMember[] @relation("WorkspaceMemberInviter")

  @@index([deletedAt])
  @@index([createdAt])
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(160)
  slug         String        @db.VarChar(180)
  type         WorkspaceType @default(PERSONAL)
  description  String?       @db.VarChar(1000)
  avatarUrl    String?       @db.VarChar(2048)
  isArchived   Boolean       @default(false)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  teams            Team[]
  assets           Asset[]
  exports          Export[]
  tags             Tag[]
  userRoles        UserRole[]
  workspaceMembers WorkspaceMember[]
  userDrafts       UserDraft[]

  @@index([deletedAt])
  @@index([createdAt])
  @@index([type])
}

model Team {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  ownerId     String?   @db.Uuid
  name        String    @db.VarChar(160)
  slug        String    @db.VarChar(180)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  owner     User?      @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  userRoles UserRole[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([ownerId])
  @@index([deletedAt])
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique @db.VarChar(80)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(400)
  isSystem    Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([deletedAt])
  @@index([isSystem])
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique @db.VarChar(120)
  description String?   @db.VarChar(400)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]

  @@index([deletedAt])
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  invitedBy   String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter   User?     @relation("WorkspaceMemberInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([role])
}

model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  workspaceId String?  @db.Uuid
  teamId      String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, workspaceId, teamId])
  @@index([userId])
  @@index([roleId])
  @@index([workspaceId])
  @@index([teamId])
}

model EditorType {
  id        String    @id @default(uuid()) @db.Uuid
  key       String    @unique @db.VarChar(80)
  name      String    @db.VarChar(120)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  categories Category[]
  templates  Template[]

  @@index([deletedAt])
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  editorTypeId String    @db.Uuid
  parentId     String?   @db.Uuid
  name         String    @db.VarChar(140)
  slug         String    @db.VarChar(180)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  editorType EditorType @relation(fields: [editorTypeId], references: [id], onDelete: Restrict)
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[] @relation("CategoryHierarchy")
  seo        CategorySeo?
  templates  Template[]
  @@unique([slug])
  @@index([editorTypeId])
  @@index([parentId])
  @@index([deletedAt])
}

model CategorySeo {
  id              String    @id @default(uuid()) @db.Uuid
  categoryId      String    @unique @db.Uuid
  metaTitle       String?   @db.VarChar(60)
  metaDescription String?   @db.VarChar(160)
  metaKeywords    String?   @db.VarChar(255)
  ogTitle         String?   @db.VarChar(100)
  ogDescription   String?   @db.VarChar(160)
  ogImage         String?   @db.VarChar(2048)
  canonicalUrl    String?   @db.VarChar(512)
  robotsMeta      String?   @db.VarChar(100)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([deletedAt])
  @@map("CategorySEO")
}

model Template {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(240)
  slug         String   @unique @db.VarChar(260)
  authorId     String   @db.Uuid
  editorTypeId String   @db.Uuid
  categoryId   String   @db.Uuid
  thumbnail    String?  @db.VarChar(2048)
  status       String   @default("draft") @db.VarChar(40)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author     User             @relation("TemplateAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  editorType EditorType       @relation(fields: [editorTypeId], references: [id], onDelete: Restrict)
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  content    TemplateContent?
  drafts     UserDraft[]

  @@index([authorId])
  @@index([editorTypeId])
  @@index([editorTypeId, status])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
}

model TemplateContent {
  templateId String @id @db.Uuid
  content    Json

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model UserDraft {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  workspaceId  String?   @db.Uuid
  templateId   String?   @db.Uuid
  name         String    @db.VarChar(240)
  thumbnail    String?   @db.VarChar(2048)
  content      Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastOpenedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  template  Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([templateId])
  @@index([userId, workspaceId])
  @@index([userId, templateId])
  @@index([lastOpenedAt])
}

model Asset {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  uploadedById    String?   @db.Uuid
  fileName        String    @db.VarChar(255)
  mimeType        String    @db.VarChar(120)
  fileSizeBytes   BigInt
  storageProvider String    @default("s3") @db.VarChar(40)
  storageKey      String    @db.VarChar(512)
  publicUrl       String?   @db.VarChar(2048)
  checksumSha256  String?   @db.VarChar(128)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([uploadedById])
  @@index([storageKey])
  @@index([deletedAt])
  @@index([createdAt])
}

model Export {
  id               String    @id @default(uuid()) @db.Uuid
  requestedByUserId String?   @db.Uuid
  workspaceId      String?   @db.Uuid
  draftId          String?   @db.Uuid
  templateId       String?   @db.Uuid
  format           String    @default("pdf") @db.VarChar(20)
  status           String    @default("pending") @db.VarChar(30)
  fileName         String    @db.VarChar(255)
  downloadPath     String?   @db.VarChar(2048)
  content          Json
  errorMessage     String?   @db.VarChar(1000)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  requestedByUser User?      @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([requestedByUserId])
  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

model Tag {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String    @db.VarChar(80)
  slug        String    @db.VarChar(100)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([deletedAt])
}
