generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique @db.VarChar(320)
  displayName String?   @db.VarChar(120)
  avatarUrl   String?   @db.VarChar(2048)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownedTeams       Team[]            @relation("TeamOwner")
  templateAuthored Template[]        @relation("TemplateAuthor")
  versionsAuthored TemplateVersion[] @relation("TemplateVersionAuthor")
  assets           Asset[]
  favorites        Favorite[]
  comments         Comment[]
  userRoles        UserRole[]

  @@index([deletedAt])
  @@index([createdAt])
}

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(160)
  slug      String    @unique @db.VarChar(180)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teams      Team[]
  categories Category[]
  templates  Template[]
  assets     Asset[]
  tags       Tag[]
  UserRole   UserRole[]

  @@index([deletedAt])
  @@index([createdAt])
}

model Team {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  ownerId     String?   @db.Uuid
  name        String    @db.VarChar(160)
  slug        String    @db.VarChar(180)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  owner     User?      @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  templates Template[]
  userRoles UserRole[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([ownerId])
  @@index([deletedAt])
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique @db.VarChar(80)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(400)
  isSystem    Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([deletedAt])
  @@index([isSystem])
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique @db.VarChar(120)
  description String?   @db.VarChar(400)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]

  @@index([deletedAt])
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  workspaceId String?  @db.Uuid
  teamId      String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, workspaceId, teamId])
  @@index([userId])
  @@index([roleId])
  @@index([workspaceId])
  @@index([teamId])
}

model EditorType {
  id        String    @id @default(uuid()) @db.Uuid
  key       String    @unique @db.VarChar(80)
  name      String    @db.VarChar(120)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  categories Category[]
  templates  Template[]

  @@index([deletedAt])
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  editorTypeId String    @db.Uuid
  parentId     String?   @db.Uuid
  name         String    @db.VarChar(140)
  slug         String    @db.VarChar(180)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  editorType    EditorType         @relation(fields: [editorTypeId], references: [id], onDelete: Restrict)
  parent        Category?          @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[]         @relation("CategoryHierarchy")
  templateLinks TemplateCategory[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([editorTypeId])
  @@index([parentId])
  @@index([deletedAt])
}

model Template {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  teamId           String?   @db.Uuid
  authorId         String?   @db.Uuid
  editorTypeId     String    @db.Uuid
  title            String    @db.VarChar(240)
  slug             String    @db.VarChar(260)
  description      String?   @db.VarChar(2000)
  thumbnailAssetId String?   @db.Uuid
  status           String    @default("draft") @db.VarChar(40)
  isPublic         Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team               Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  author             User?              @relation("TemplateAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  editorType         EditorType         @relation(fields: [editorTypeId], references: [id], onDelete: Restrict)
  thumbnailAsset     Asset?             @relation("TemplateThumbnail", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  versions           TemplateVersion[]
  templateTags       TemplateTag[]
  templateCategories TemplateCategory[]
  favorites          Favorite[]
  comments           Comment[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([teamId])
  @@index([authorId])
  @@index([editorTypeId])
  @@index([thumbnailAssetId])
  @@index([status])
  @@index([isPublic])
  @@index([deletedAt])
  @@index([createdAt])
}

model TemplateVersion {
  id            String    @id @default(uuid()) @db.Uuid
  templateId    String    @db.Uuid
  versionNumber Int
  content       Json
  changelog     String?   @db.VarChar(2000)
  createdById   String?   @db.Uuid
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  template  Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("TemplateVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([templateId, versionNumber])
  @@index([templateId])
  @@index([createdById])
  @@index([deletedAt])
  @@index([createdAt])
}

model Asset {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  uploadedById    String?   @db.Uuid
  fileName        String    @db.VarChar(255)
  mimeType        String    @db.VarChar(120)
  fileSizeBytes   BigInt
  storageProvider String    @default("s3") @db.VarChar(40)
  storageKey      String    @db.VarChar(512)
  publicUrl       String?   @db.VarChar(2048)
  checksumSha256  String?   @db.VarChar(128)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy      User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  templateThumbOf Template[] @relation("TemplateThumbnail")

  @@index([workspaceId])
  @@index([uploadedById])
  @@index([storageKey])
  @@index([deletedAt])
  @@index([createdAt])
}

model Tag {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String    @db.VarChar(80)
  slug        String    @db.VarChar(100)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  templateTags TemplateTag[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([deletedAt])
}

model TemplateTag {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  tagId      String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([templateId, tagId])
  @@index([templateId])
  @@index([tagId])
}

model TemplateCategory {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  categoryId String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([templateId, categoryId])
  @@index([templateId])
  @@index([categoryId])
}

model Favorite {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  templateId String    @db.Uuid
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([userId])
  @@index([templateId])
  @@index([deletedAt])
}

model Comment {
  id         String    @id @default(uuid()) @db.Uuid
  templateId String    @db.Uuid
  userId     String?   @db.Uuid
  parentId   String?   @db.Uuid
  body       String    @db.Text
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  template Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")

  @@index([templateId])
  @@index([userId])
  @@index([parentId])
  @@index([deletedAt])
  @@index([createdAt])
}
