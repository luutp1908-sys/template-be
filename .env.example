NODE_ENV=development
MOCK_MODE=false
PORT=4000
APP_NAME=template-saas-backend
API_PREFIX=api
SWAGGER_PATH=docs
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/template_saas?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=info
