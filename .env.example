NODE_ENV=development
MOCK_MODE=false
PORT=4000
APP_NAME=template-saas-backend
API_PREFIX=api
SWAGGER_PATH=docs
TRUST_PROXY=0
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DATABASE_STARTUP_MODE=warn
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template_saas?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENABLED=true
CACHE_KEY_PREFIX=template-saas
CACHE_CONNECT_TIMEOUT_MS=2000
CACHE_CATEGORY_TREE_TTL_MS=3600000
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_BLOCK_DURATION_MS=120000
THROTTLE_AUTH_LOGIN_LIMIT=10
THROTTLE_AUTH_LOGIN_TTL_MS=60000
THROTTLE_AUTH_LOGIN_BLOCK_DURATION_MS=300000
THROTTLE_AUTH_REGISTER_LIMIT=5
THROTTLE_AUTH_REGISTER_TTL_MS=60000
THROTTLE_AUTH_REGISTER_BLOCK_DURATION_MS=600000
THROTTLE_AUTH_REFRESH_LIMIT=20
THROTTLE_AUTH_REFRESH_TTL_MS=60000
THROTTLE_AUTH_REFRESH_BLOCK_DURATION_MS=300000
BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=info
