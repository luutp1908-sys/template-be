aws_region   = "ap-southeast-1"
project_name = "template-saas"
environment  = "prod"

# Keep az_count at 2 for baseline redundancy.
az_count = 2

# Cost-aware baseline: no NAT gateways in Phase 2.
vpc_cidr             = "10.40.0.0/16"
public_subnet_cidrs  = ["10.40.0.0/20", "10.40.16.0/20"]
private_subnet_cidrs = ["10.40.128.0/20", "10.40.144.0/20"]

# Replace with office/VPN CIDRs before public exposure.
allowed_ingress_cidrs = ["0.0.0.0/0"]
app_port              = 4000

repository_names               = ["be-monolith", "be-export-service"]
ecr_lifecycle_keep_image_count = 30

# Phase 3: data services (cost-aware baseline)
enable_data_services            = true
db_name                         = "template_saas"
db_username                     = "template_admin"
db_instance_class               = "db.t4g.micro"
db_allocated_storage            = 20
db_max_allocated_storage        = 100
db_engine_version               = "16.15"
db_backup_retention_period      = 7
db_multi_az                     = false
db_deletion_protection          = false
redis_node_type                 = "cache.t4g.micro"
redis_engine_version            = "7.1"
redis_port                      = 6379
redis_automatic_failover_enabled = false
secret_recovery_window_in_days  = 7

# Phase 4: ECS services
enable_vpc_endpoints                = true
enable_ecs                          = true
container_port                      = 4000
health_check_path                   = "/api/v1/health"
ecs_task_cpu                        = 512
ecs_task_memory                     = 1024
ecs_desired_count                   = 1
ecs_health_check_grace_period_seconds = 90
log_retention_days                  = 14
monolith_image_tag                  = "latest"
enable_https_listener               = false
certificate_arn_override            = null
ecs_execution_role_arn              = null
ecs_task_role_arn                   = null

# Runtime env for monolith
frontend_origin       = "https://example.com"
api_prefix            = "api"
swagger_path          = "docs"
trust_proxy           = 1
node_env              = "production"
log_level             = "info"
database_startup_mode = "fail-fast"
cache_enabled         = true
cache_key_prefix      = "template-saas"
export_service_url    = ""
jwt_access_expires_in = "15m"
jwt_refresh_expires_in = "7d"
bcrypt_salt_rounds    = 12
enable_request_logs   = false

# Domain is not ready yet, keep ACM disabled.
enable_acm                        = false
domain_name                       = ""
subject_alternative_names         = []
route53_zone_id                   = ""
create_route53_validation_records = false

extra_tags = {
  Owner = "backend-team"
}
